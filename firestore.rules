rules_version = '2';

// Reglas de Firestore de ATLAS / TechPack. Se publican con:
//   firebase deploy --only firestore:rules
// (2026-10-19, seguridad) Antes: cualquier cuenta con sesión leía y escribía TODO. Ahora el rol,
// si es admin y los clientes asociados viajan en la sesión (custom claims: rol, admin, clientes),
// que mantiene el backend (functions/index.js: sincronizarClaimsUsuario / sincronizarMisClaims).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Una cuenta "con claims" es la que ya sincronizó su rol (entró con la versión nueva de la app).
    // Mientras no los tenga se la trata como empleado normal (así nadie queda por fuera durante la
    // transición); cuando todos hayan entrado, se puede cerrar ese margen.
    function conClaims() { return signedIn() && ('rol' in request.auth.token); }
    function esAdmin() { return conClaims() && request.auth.token.get('admin', false) == true; }
    function esCliente() { return conClaims() && request.auth.token.rol == 'Cliente'; }

    // Colecciones internas que un usuario de rol Cliente nunca debe leer ni escribir.
    function sensible(col) {
      return col.matches('(nomina|contabilidad|centro_costo|kpi|cotizador|dado_por_cumplido|asistente)_.*')
        || col in ['financiera_pagos', 'financiera_pagos_persona', 'abonosVenezuela', 'cuentaYulianaVenezuela', 'despachosDubo',
                   'despachosVenezuela', 'ventas_perdidas_cargas', 'precios_corte_cargas',
                   'lotes_servicio_confeccion'];
    }

    // Perfiles: todos los leen (la app los necesita), pero SOLO un administrador los escribe.
    // Cierra el hueco de que alguien se ponga isAdmin: true en su propio documento.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if esAdmin();
    }

    // Cotizaciones: un Cliente solo lee las de sus clientes asociados y nunca escribe.
    match /cotizaciones/{cotId} {
      allow read: if signedIn()
        && (!esCliente() || resource.data.get('cliente', 'General') in request.auth.token.get('clientes', []));
      allow write: if signedIn() && !esCliente();
    }

    // Devoluciones de clientes (2026-10-20): un Cliente solo LEE lo que él mismo creó y solo puede
    // CREAR devoluciones a su nombre en estado inicial; nunca las modifica ni las borra (los estados
    // los cambia el personal interno: Bodega recibe/re-despacha, Calidad revisa). El personal
    // interno lee y escribe todo. OJO: esta colección se excluye abajo de la regla general, porque
    // si no, esa regla (que permite todo a quien tenga sesión) anularía esta.
    match /devoluciones_cliente/{devId} {
      allow read: if signedIn() && (!esCliente() || resource.data.get('creadoPorUid', '') == request.auth.uid);
      allow create: if signedIn() && (!esCliente()
        || (request.resource.data.get('creadoPorUid', '') == request.auth.uid
            && request.resource.data.get('estado', '') in ['reportada', 'en_camino']));
      // (2026-10-21) Editar: el personal interno siempre; un Cliente solo su propia devolución mientras
      // está reportada / en camino (antes de que Bodega la reciba), sin cambiar de dueño ni de estado.
      allow update: if signedIn() && (!esCliente()
        || (resource.data.get('creadoPorUid', '') == request.auth.uid
            && resource.data.get('estado', '') in ['reportada', 'en_camino']
            && request.resource.data.get('creadoPorUid', '') == request.auth.uid
            && request.resource.data.get('estado', '') in ['reportada', 'en_camino']));
      // Borrar: solo el administrador.
      allow delete: if esAdmin();
    }

    // Códigos de autorización de permisos (2026-10-28): SOLO el servidor (Admin SDK) los lee y escribe,
    // para que nadie los vea desde el navegador. Generar/validar/anular va por funciones.
    match /nomina_codigos_permiso/{id} {
      allow read, write: if false;
    }

    // Todo lo demás: cualquier cuenta con sesión, salvo lo sensible para el rol Cliente.
    match /{col}/{rest=**} {
      allow read, write: if signedIn()
        && col != 'users' && col != 'cotizaciones' && col != 'devoluciones_cliente' && col != 'nomina_codigos_permiso'
        // El asistente solo escribe/lee estas dos con el servidor (Admin SDK): ningún usuario las toca directo.
        && col != 'asistente_log' && col != 'asistente_recordatorios'
        && (!esCliente() || !sensible(col));
    }
  }
}
